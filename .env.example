# General Config
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (Optional for mock mode; Required for live Supabase)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Auth Secret (Used for Express JWT handling in local/fallback auth)
JWT_SECRET=super-secret-jwt-key-change-in-production-2026

# Resend Email API Key (Optional for mock mode; Required for sending emails)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=oems-notifications@college.edu
